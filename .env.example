# ObraJá — Variáveis de ambiente do monorepo
# Cada app tem seu próprio .env.local — este arquivo é referência global.
# NUNCA commite arquivos .env com valores reais.

# ─── Web apps (Next.js) ───────────────────────────────────────────────────────
# Copie para apps/web-*/. env.local
NEXT_PUBLIC_API_URL=https://api.divixstudio.io

# ─── Mobile apps (Expo) ───────────────────────────────────────────────────────
# Copie para apps/mobile*/.env
EXPO_PUBLIC_API_URL=https://api.divixstudio.io

# ─── Google Maps (para rastreamento no mobile) ────────────────────────────────
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# ObraJá API — Variáveis de ambiente
# Copie para packages/api/.env e preencha os valores reais.
# NUNCA commite o arquivo .env

# ─── Banco de dados (PostgreSQL local no VPS) ─────────────────────────────────
DATABASE_URL=postgresql://obraja_user:SENHA_SEGURA@localhost:5432/obraja_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3333

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://divixstudio.io,https://loja.divixstudio.io,https://admin.divixstudio.io

# ─── Email transacional (SendGrid) ────────────────────────────────────────────
SENDGRID_API_KEY=

# ─── Pagamentos ───────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=

# ─── Storage (local no VPS ou S3-compatible) ──────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/var/www/obraja/uploads
STORAGE_BASE_URL=https://api.divixstudio.io/uploads

# ─── Firebase (push notifications) ────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
